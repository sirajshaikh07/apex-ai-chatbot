    process delete-user (
        name: Delete User Account
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                DECLARE
                    l_uname VARCHAR2(255);
                BEGIN
                    IF :P2_ACTION_REQ_ID IS NOT NULL THEN
                        BEGIN
                            SELECT username INTO l_uname FROM user_registrations WHERE request_id = :P2_ACTION_REQ_ID;
                        EXCEPTION
                            WHEN NO_DATA_FOUND THEN l_uname := NULL;
                        END;

                        IF l_uname IS NOT NULL THEN
                            BEGIN
                                apex_util.set_workspace(p_workspace => 'AIWORKSPACE');
                                IF apex_util.get_user_id(l_uname) IS NOT NULL THEN
                                    apex_util.remove_user(p_user_name => l_uname);
                                END IF;
                            EXCEPTION
                                WHEN OTHERS THEN NULL;
                            END;
                        END IF;

                        DELETE FROM user_registrations WHERE request_id = :P2_ACTION_REQ_ID;
                        COMMIT;

                        apex_application.g_print_success_message :=
                            'User account "' || NVL(l_uname, 'ID ' || :P2_ACTION_REQ_ID) || '" and login access permanently deleted.';
                        :P2_ACTION_REQ_ID := NULL;
                    END IF;
                END;
                ```
        }
        execution {
            sequence: 50
            point: afterSubmit
        }
        serverSideCondition {
            type: request=Value
            value: DELETE_USER
        }
        advanced {
            executionMappingIdentifier: 102005
        }
    )

